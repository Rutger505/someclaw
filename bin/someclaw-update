#!/bin/bash
# Pushes local commits, fast-forwards to origin/main, reruns install.sh (deps + UI build + units) and restarts
# someclaw.service only when server code (server.ts, server/, shared/) or a unit changed. UI builds need no restart: open pages reload themselves.
# Run by bin/deploy right after a push, else by the 1-min timer.

cd "$(dirname "$(realpath "$0")")/.." || exit 1

fail() {
  echo "$1"
  exit 1
}

git diff --quiet HEAD || fail "Repository has uncommitted changes"
git fetch --quiet || fail "Fetch failed"

if [ -n "$(git rev-list '@{upstream}..@')" ]; then
  git push --quiet || fail "Push failed"
fi

git diff --quiet @ '@{upstream}' && exit 0

changed="$(git diff --name-only @ '@{upstream}')"
git merge --quiet --ff-only '@{upstream}' || fail "Local branch diverged from upstream"
./install.sh || fail "install.sh failed"
if grep -qE '^(server\.ts|server/|shared/|systemd/)' <<<"$changed"; then
  systemctl --user restart someclaw.service || fail "Restarting someclaw failed"
  echo "Updated to $(git rev-parse --short @), restarted"
else
  echo "Updated to $(git rev-parse --short @), no restart needed"
fi
